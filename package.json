{
  "name": "gamestudio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "seed:users": "node --env-file-if-exists=.env.seed scripts/seed-users.mjs",
    "dev:local": "vite --mode localstack",
    "seed:users:local": "node --env-file-if-exists=.env.seed.local scripts/seed-users.mjs",
    "demo:reset": "node --env-file-if-exists=.env.seed scripts/demo-reset.mjs",
    "test": "vitest run",
    "test:sql": "scripts/test-sql.sh",
    "check:functions": "cd supabase/functions && npx -y deno@2.5.6 check --node-modules-dir=none */index.ts _shared/*.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "5.0.3"
  }
}
